rules_version = '2';

// Cole este ficheiro em: Firebase Console → Firestore Database → Regras → Publicar
//
// Modelo de dados:
//   negocios/{slug}                 { donoUid, cfg{...}, criadoEm, atualizadoEm }
//   negocios/{slug}/marcacoes/{id}  dados do cliente (privado: só o dono lê)
//   negocios/{slug}/ocupados/{id}   células de agenda ocupadas (público, sem dados pessoais)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(slug) {
      return request.auth != null
        && get(/databases/$(database)/documents/negocios/$(slug)).data.donoUid == request.auth.uid;
    }

    function marcacaoValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data','hora','inicio','dur','servico','preco','barbeiroId',
                               'barbeiroNome','cliente','telefone','email','estado','celulas','criadoEm'])
        && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.hora is string && d.hora.matches('^[0-9]{2}:[0-9]{2}$')
        && d.inicio is number && d.dur is number && d.dur >= 15 && d.dur <= 180
        && d.servico is string && d.servico.size() <= 50
        && d.preco is number && d.preco >= 0
        && d.barbeiroId is string && d.barbeiroId.size() <= 12
        && d.barbeiroNome is string && d.barbeiroNome.size() <= 40
        && d.cliente is string && d.cliente.size() > 0 && d.cliente.size() <= 60
        && d.telefone is string && d.telefone.size() <= 25
        && d.email is string && d.email.size() <= 120
        && d.estado in ['pendente','confirmada']
        && d.celulas is list && d.celulas.size() >= 1 && d.celulas.size() <= 17
        && d.criadoEm == request.time;
    }

    match /negocios/{slug} {
      // Qualquer pessoa pode abrir a página de uma barbearia
      allow read: if true;

      // Qualquer utilizador com sessão iniciada pode criar a sua barbearia (link ainda livre)
      allow create: if request.auth != null
        && slug.matches('^[a-z0-9-]{3,40}$')
        && request.resource.data.donoUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['donoUid','cfg','criadoEm','atualizadoEm']);

      // Só o dono edita, e não pode passar a barbearia para outro
      allow update: if isOwner(slug)
        && request.resource.data.donoUid == resource.data.donoUid;

      allow delete: if false;

      match /marcacoes/{id} {
        // Cliente cria como "pendente"; o dono pode criar já "confirmada" (marcação manual)
        allow create: if marcacaoValida()
          && exists(/databases/$(database)/documents/negocios/$(slug))
          && (request.resource.data.estado == 'pendente' || isOwner(slug));
        // Dados do cliente: só o dono vê e gere
        allow read, update, delete: if isOwner(slug);
      }

      match /ocupados/{id} {
        // Público: só diz "este horário está ocupado", sem nomes nem telefones
        allow read: if true;

        // Só se cria junto com uma marcação (mesmo batch) que referencia esta célula.
        // O ID fixo (data_minuto_barbeiro) impede duas marcações no mesmo horário.
        allow create: if request.resource.data.keys().hasOnly(['data','c','b','mid'])
          && request.resource.data.data is string
          && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.c is number
          && request.resource.data.b is string && request.resource.data.b.size() <= 12
          && request.resource.data.mid is string
          && id == request.resource.data.data + '_' + string(request.resource.data.c) + '_' + request.resource.data.b
          && (id in getAfter(/databases/$(database)/documents/negocios/$(slug)/marcacoes/$(request.resource.data.mid)).data.celulas);

        // Libertar horário (cancelar marcação): só o dono
        allow delete: if isOwner(slug);
        allow update: if false;
      }

    }

    match /mail/{id} {
      // Fila consumida por Firebase Trigger Email; só o proprietário da barbearia pode criar pedidos.
      allow create: if request.auth != null
        && request.resource.data.slug is string
        && isOwner(request.resource.data.slug)
        && request.resource.data.keys().hasOnly(['slug','to','message','tipo','marcacaoId','criadoEm'])
        && request.resource.data.to is string
        && request.resource.data.to.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.message is map
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string
        && request.resource.data.tipo == 'confirmacao'
        && request.resource.data.marcacaoId is string
        && request.resource.data.criadoEm == request.time;
      allow read, update, delete: if false;
    }
  }
}
